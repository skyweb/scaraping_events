# Configurazione non-sensibile — i secret sono in oke-vault.yml (criptato)
# Vedi oke-vault.yml.example per il template dei secret.

# OCIR (Oracle Container Registry) - per imagePullSecret Kubernetes
# Questi valori si ottengono dagli output Terraform dopo il deploy:
#   terraform output ocir_endpoint              → ocir_endpoint
#   terraform output objectstorage_namespace    → ocir_namespace
#   terraform output -raw ocir_auth_token       → ocir_auth_token (→ oke-vault.yml)
#   terraform output ocir_repositories          → lista immagini full path
ocir_region: "eu-milan-1"
ocir_endpoint: "eu-milan-1.ocir.io"
ocir_namespace: "YOUR_TENANCY_NAMESPACE"  # terraform output objectstorage_namespace
ocir_username: "YOUR_TENANCY_NAMESPACE/YOUR_EMAIL"  # formato: <objectstorage_namespace>/<email> (NON il tenancy name)
# ocir_auth_token → in oke-vault.yml

# Namespaces da creare nel cluster
namespaces:
  - database
  - apps
  - airflow
  - devs
  - monitoring
  - clusters
  - traefik
  - cert-manager
  - linkerd
  - linkerd-viz
  - wireguard

# Traefik Ingress Controller
install_traefik: true
traefik_http_nodeport: 30080
traefik_https_nodeport: 30443
traefik_dashboard_nodeport: 30090

# cert-manager
install_cert_manager: true
cert_manager_version: "v1.17.2"
letsencrypt_email: "YOUR_EMAIL@example.com"

# metrics-server
install_metrics_server: true

# Kubernetes Dashboard
install_dashboard: true

# Grafana (in-cluster via Helm)
install_grafana: true

# Grafana Tempo (distributed tracing, sostituisce Jaeger)
install_tempo: true

# SonarQube (Code Quality & Security)
install_sonarqube: true

# Backstage (Spotify Developer Portal)
install_backstage: true

# Airflow (DAG Orchestration)
install_airflow: true

# MinIO (Object Storage S3-compatible)
install_minio: true
minio_storage_size: "50Gi"
# Bucket da creare automaticamente al primo deploy (opzionale)
minio_default_buckets:
  - airflow-logs
  - mlflow-artifacts

# Kong API Gateway + Konga Admin UI
install_kong: true

# Linkerd (Service Mesh — mTLS)
install_linkerd: true

# Kyverno (Policy Engine - Security)
install_kyverno: false
# Audit = solo log violazioni, Enforce = blocca le risorse non conformi
kyverno_enforcement_mode: "Audit"
# Namespace esclusi dalle policy (sistema e infrastruttura)
kyverno_excluded_namespaces:
  - kube-system
  - clusters
  - traefik
  - cert-manager
  - monitoring
  - database
  - linkerd
  - linkerd-viz

# IP privato di un nodo K8s (usato da reverse-proxy-setup per DNAT → Traefik)
# Ottenere con: kubectl get nodes -o wide → INTERNAL-IP del nodo light
k8s_node_ip: "K8S_NODE_PRIVATE_IP"

# =============================================================================
# Backup & Disaster Recovery
# =============================================================================

# Velero (Backup & Disaster Recovery)
install_velero: true

# OCI Object Storage (S3-compatible) per backup
# Questi valori si ottengono dagli output Terraform dopo il deploy:
#   terraform output velero_bucket_name
#   terraform output velero_s3_endpoint
#   terraform output velero_s3_access_key
#   terraform output -raw velero_s3_secret_key
velero_bucket_name: "velero-backups"
velero_s3_region: "eu-milan-1"
velero_s3_url: "https://YOUR_TENANCY_NAMESPACE.compat.objectstorage.eu-milan-1.oraclecloud.com"
# velero_aws_access_key_id → in oke-vault.yml
# velero_aws_secret_access_key → in oke-vault.yml
# Schedule backup automatici (cron)
velero_backup_schedule: "0 2 * * *"  # ogni notte alle 02:00
velero_backup_ttl: "168h"            # retention 7 giorni

# Velero UI (otwld/velero-ui) — Dashboard web per Velero
install_velero_ui: true
# velero_subdomain: "velero"  # velero.oci.santocaruso.eu

# =============================================================================
# ArgoCD Application (usato da backup-setup.yml per Velero UI)
# =============================================================================
argocd_repo_url: "https://github.com/skyweb/scaraping_events.git"
argocd_target_revision: "main"

# =============================================================================
# Reverse Proxy (TCP forwarding via firewalld su micro-gw — IP stabile)
# =============================================================================
# Quando abilitato, micro-gw (IP stabile) inoltra traffico TCP grezzo
# (porte 80/443) a Traefik nel cluster K8s via firewalld DNAT.
# Traefik gestisce TLS (Let's Encrypt ACME) e L7 routing.
# Flusso: DNS → micro-gw (firewalld DNAT) → k8s NodePort → Traefik (TLS + L7)
# Vantaggi: IP stabile, no duplicazione config (solo IngressRoute K8s).
install_reverse_proxy: true

# =============================================================================
# WireGuard VPN (server nativo su micro-gw)
# =============================================================================
# Quando abilitato, micro-gw esegue un server WireGuard nativo.
# I client VPN possono raggiungere nodi K8s (10.0.1.0/24) e micro VM (10.0.3.0/28).
# VPN Subnet: 10.10.0.0/24, Porta: 51820
install_wireguard: true
# CIDR K8s — abilita accesso VPN a pod e service del cluster
# Ottenere da: kubectl cluster-info dump | grep -m1 cluster-cidr / service-cluster-ip-range
wg_k8s_pod_cidr: "10.244.0.0/16"
wg_k8s_service_cidr: "10.96.0.0/16"

# =============================================================================
# Domain Setup (HTTPS via sottodomini)
# =============================================================================
# Decommentare e configurare per abilitare routing HTTPS via sottodomini.
# Richiede: DNS A record per ogni sottodominio → IP pubblico corretto.
#
# Senza reverse proxy:
#   Servizi K8s → A record → IP pubblico del nodo light (K8s)
# Con reverse proxy (install_reverse_proxy: true):
#   TUTTI i sottodomini → A record → IP pubblico micro-gw (stabile)

base_domain: "oci.santocaruso.eu"

# Sottodomini (default se non specificati)
# traefik_subdomain: "traefik"        # traefik.example.com   → Traefik Dashboard
# dashboard_subdomain: "dashboard"    # dashboard.example.com → K8s Dashboard
# auth_subdomain: "auth"              # auth.example.com      → OAuth2 Proxy callback

# --- Autenticazione servizi senza auth nativa ---
# OAuth2 Proxy (Google SSO)

install_oauth2_proxy: true
oauth2_proxy_allowed_emails:
  - "santo.caruso@gmail.com"
  - "santo.caruso@altrama.com"
# Google Cloud Console: Credentials → OAuth 2.0 Client ID (tipo: Web application)
# Authorized redirect URI: https://auth.<base_domain>/oauth2/callback
# I secret (client_id, client_secret, cookie_secret) → in oke-vault.yml
