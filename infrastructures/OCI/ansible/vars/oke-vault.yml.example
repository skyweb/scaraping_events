# Secret e credenziali — questo file viene criptato con Ansible Vault
#
# Copiare: cp oke-vault.yml.example oke-vault.yml
# Editare con i valori reali, poi criptare:
#   ansible-vault encrypt oke-vault.yml
#
# Per editare dopo la cifratura:
#   ansible-vault edit oke-vault.yml
#
# Lanciare con: ansible-playbook ... --ask-vault-pass
# Oppure con vault password file: ansible-playbook ... --vault-password-file ~/.vault_pass
---

# OCIR (Oracle Container Registry)
ocir_auth_token: "CHANGE_ME"  # Console OCI: My Profile → Auth tokens → Generate token

# Velero (Backup)
velero_aws_access_key_id: "YOUR_ACCESS_KEY_ID"
velero_aws_secret_access_key: "YOUR_SECRET_ACCESS_KEY"

# Velero UI
velero_ui_password: "CHANGE_ME"

# Grafana
grafana_admin_password: "CHANGE_ME"

# PostgreSQL (database condiviso)
postgres_password: "CHANGE_ME"

# Harbor (Docker Registry)
harbor_admin_password: "CHANGE_ME"
harbor_postgres_password: "CHANGE_ME"
harbor_oidc_client_secret: "CHANGE_ME"
harbor_robot_secret: "CHANGE_ME"

# Backstage (Developer Portal)
backstage_postgres_password: "CHANGE_ME"

# Airflow (DAG Orchestration)
airflow_postgres_password: "CHANGE_ME"
airflow_admin_password: "CHANGE_ME"
airflow_secret_key: "CHANGE_ME"
airflow_api_user: "admin"               # utente per trigger DAG da backoffice
airflow_api_password: "CHANGE_ME"       # password per trigger DAG da backoffice

# Keycloak
keycloak_admin_password: "CHANGE_ME"
keycloak_db_password: "CHANGE_ME"
keycloak_backoffice_client_secret: "CHANGE_ME"
keycloak_scraper_client_secret: "CHANGE_ME"
keycloak_airflow_client_secret: "CHANGE_ME"
keycloak_google_client_secret: "CHANGE_ME"

# Scraping Service (OAuth2 client credentials per spider → backoffice API)
scraping_api_client_id: "CHANGE_ME"
scraping_api_client_secret: "CHANGE_ME"

# Backoffice (credenziali sensibili Django)
backoffice_django_secret_key: "CHANGE_ME"
backoffice_gemini_api_key: "CHANGE_ME"
backoffice_groq_api_key: "CHANGE_ME"
backoffice_celery_broker_url: "redis://redis.database.svc:6379/1"
backoffice_cache_redis_url: "redis://redis.database.svc:6379/2"

# MinIO (Object Storage)
minio_root_user: "minioadmin"
minio_root_password: "CHANGE_ME"

# WireGuard VPN (server su micro-gw)
# Generare con: wg genkey
wg_server_private_key: "CHANGE_ME"
# Lista peer (client VPN) — decommentare e configurare:
# wg_peers:
#   - public_key: "CLIENT_PUBLIC_KEY"
#     allowed_ips: "10.10.0.2/32"
#   - public_key: "ANOTHER_CLIENT_PUBLIC_KEY"
#     allowed_ips: "10.10.0.3/32"
