{
  "annotations": { "list": [] },
  "description": "Dashboard APISIX API Gateway - Traffico, connessioni, stato",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "etcd Reachable",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "apisix_etcd_reachable{job=\"apisix\"}", "legendFormat": "etcd", "refId": "A", "instant": true }
      ],
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }] } }
    },
    {
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "apisix_http_requests_total{job=\"apisix\"}", "legendFormat": "Requests", "refId": "A", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "apisix_nginx_http_current_connections{job=\"apisix\", state=\"active\"}", "legendFormat": "Active", "refId": "A", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] } } }
    },
    {
      "title": "Routes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "apisix_etcd_modify_indexes{job=\"apisix\", key=\"routes\"}", "legendFormat": "Routes", "refId": "A", "instant": true }
      ]
    },
    {
      "title": "Upstreams",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "apisix_etcd_modify_indexes{job=\"apisix\", key=\"upstreams\"}", "legendFormat": "Upstreams", "refId": "A", "instant": true }
      ]
    },
    {
      "title": "SSL Certs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "apisix_etcd_modify_indexes{job=\"apisix\", key=\"ssls\"}", "legendFormat": "SSLs", "refId": "A", "instant": true }
      ]
    },
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(apisix_http_requests_total{job=\"apisix\"}[5m])", "legendFormat": "req/s", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },
    {
      "title": "Connections by State",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "apisix_nginx_http_current_connections{job=\"apisix\"}", "legendFormat": "{{state}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15 } } }
    },
    {
      "title": "HTTP Status Codes (per-route)",
      "description": "Visibile solo con traffico che transita dalle route APISIX",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(apisix_http_status{job=\"apisix\"}[5m])) by (code)", "legendFormat": "HTTP {{code}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 50 } } }
    },
    {
      "title": "Request Latency p95 (per-route)",
      "description": "Visibile solo con traffico che transita dalle route APISIX",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(apisix_http_latency_bucket{job=\"apisix\", type=\"request\"}[5m])) by (le))", "legendFormat": "p95 total", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(apisix_http_latency_bucket{job=\"apisix\", type=\"upstream\"}[5m])) by (le))", "legendFormat": "p95 upstream", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum(rate(apisix_http_latency_bucket{job=\"apisix\", type=\"apisix\"}[5m])) by (le))", "legendFormat": "p95 apisix only", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "title": "Bandwidth (per-route)",
      "description": "Visibile solo con traffico che transita dalle route APISIX",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(apisix_bandwidth{job=\"apisix\", type=\"ingress\"}[5m]))", "legendFormat": "Ingress", "refId": "A" },
        { "expr": "sum(rate(apisix_bandwidth{job=\"apisix\", type=\"egress\"}[5m]))", "legendFormat": "Egress", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 15 } } }
    },
    {
      "title": "Shared Dict Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "(apisix_shared_dict_capacity_bytes{job=\"apisix\"} - apisix_shared_dict_free_space_bytes{job=\"apisix\"}) / apisix_shared_dict_capacity_bytes{job=\"apisix\"}", "legendFormat": "{{name}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "title": "etcd Configuration Indexes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "apisix_etcd_modify_indexes{job=\"apisix\", key!~\"max_modify_index|prev_index|x_etcd_index\"}", "legendFormat": "{{key}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 0 } } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["apisix", "gateway", "nginx"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "APISIX Gateway",
  "uid": "apisix-gateway"
}
