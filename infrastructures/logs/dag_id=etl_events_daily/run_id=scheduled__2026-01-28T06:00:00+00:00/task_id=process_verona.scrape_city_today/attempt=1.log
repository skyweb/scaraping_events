           {'date': '2026-01-18', 'time_start': '21:15', 'weekday': 'Domenica'},
           {'date': '2026-01-24', 'time_start': '21:15', 'weekday': 'Sabato'},
           {'date': '2026-01-25', 'time_start': '21:15', 'weekday': 'Domenica'},
           {'date': '2026-01-31', 'time_start': '21:15', 'weekday': 'Sabato'},
