 'scraped_at': '2026-01-30T14:23:42.500633',
 'time_info': '15.30',
 'title': 'Musica, letteratura e degustazioni: gli ingredienti della nuova '
          'edizione dei "Pomeriggi del bicchiere"',
 'url': 'https://www.forlitoday.it/eventi/i-pomeriggi-del-bicchiere-bertinoro-programma-2026.html',
 'uuid': '85b3d4eed27bd3b6'}
