 'location_name': 'Mercato coperto',
 'price': 'Prezzo non disponibile',
 'scraped_at': '2026-01-28T22:19:51.921380',
 'time_info': 'Orario non disponibile',
 'title': "La Città del Cioccolato di Perugia celebra l'amore universale per "
          'San Valentino',
 'url': 'https://www.perugiatoday.it/eventi/citta-cioccolato-perugia-san-valentino-2026-programma.html',
 'uuid': '7e03f418da317b12'}
