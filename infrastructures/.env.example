# =============================================================================
# Infrastructures - Environment Development (docker-compose.dev.yml)
# =============================================================================
# Copia questo file in .env: cp .env.example .env

# =============================================================================
# DATABASE POSTGRESQL
# =============================================================================
POSTGRES_DB=today_events
POSTGRES_USER=events
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432

# =============================================================================
# REDIS
# =============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# =============================================================================
# MONGODB
# =============================================================================
MONGO_ROOT_USERNAME=mongoadmin
MONGO_ROOT_PASSWORD=change_me_mongo_password
MONGO_PORT=27017
MONGODB_DB=today_events

# =============================================================================
# AIRFLOW
# =============================================================================
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_password
AIRFLOW_ADMIN_EMAIL=admin@airflow

# Chiavi crittografiche (generare con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY=change_me_fernet_key_base64
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_webserver_secret

# =============================================================================
# BACKOFFICE (Django)
# =============================================================================
DJANGO_SECRET_KEY=change_me_django_secret_key
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change_me_django_password

# =============================================================================
# DOMAIN (subdomain routing via APISIX)
# =============================================================================
# Dev: 127.0.0.1.nip.io (nip.io per localhost)
# Prod: dominio reale (es. events.example.com) — richiede DNS wildcard
DOMAIN=127.0.0.1.nip.io

# =============================================================================
# OPENTELEMETRY
# =============================================================================
OTEL_ENABLED=true

# =============================================================================
# MINIO (S3-compatible object storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
KEYCLOAK_MINIO_CLIENT_SECRET=change_me_minio_oidc_secret

# =============================================================================
# HARBOR REGISTRY
# =============================================================================
HARBOR_ADMIN_PASSWORD=change_me_harbor_password
# OIDC client secret per login Keycloak (deve corrispondere al client "harbor" in Keycloak)
HARBOR_OIDC_CLIENT_SECRET=change_me_harbor_oidc_secret
# Robot account per CI push e Airflow pull (creare da Harbor UI → Robot Accounts)
HARBOR_ROBOT_USER=robot$$ci-push
HARBOR_ROBOT_SECRET=change_me_harbor_robot_secret
# Immagine Scrapy usata da Airflow DockerOperator
SCRAPY_IMAGE=registry.127.0.0.1.nip.io/today-events/scraping-service:latest

# =============================================================================
# KEYCLOAK (Identity Provider)
# =============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_password

# APISIX SSO — client secret per backoffice-admin (OIDC)
# Deve corrispondere al client "backoffice-admin" nel realm Keycloak
KEYCLOAK_BACKOFFICE_CLIENT_SECRET=change_me_backoffice_oidc_secret

# =============================================================================
# SOCIAL LOGIN (Keycloak Identity Providers)
# =============================================================================
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# Homepage URL: https://auth.127.0.0.1.nip.io
# Callback URL: https://auth.127.0.0.1.nip.io/realms/today-events/broker/github/endpoint
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# AI PROVIDERS (trasformazione eventi → Schema.org)
# =============================================================================
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=change_me_gemini_api_key
# Groq: https://console.groq.com/keys
GROQ_API_KEY=change_me_groq_api_key

# =============================================================================
# PROGETTO
# =============================================================================
# Root del progetto (per calcolare path relativi nei DAG Airflow)
# Imposta il path assoluto della directory today_events sulla tua macchina
PROJECT_ROOT=/path/to/today_events
