# PostgreSQL
POSTGRES_USER=events
POSTGRES_PASSWORD=events_secret_2026
POSTGRES_DB=today_events
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2026
REDIS_UI_PORT=5540

# Airflow
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_secret_2026
AIRFLOW_ADMIN_EMAIL=admin@example.com

# API Authentication — Keycloak token endpoint
# Airflow e Scrapy ottengono JWT da Keycloak (client_credentials grant)
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/today-events/protocol/openid-connect/token
API_CLIENT_ID=airflow-service
API_CLIENT_SECRET=CHANGE_ME_AIRFLOW_SECRET

# Airflow connections
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://events:events_secret_2026@postgres:5432/today_events
AIRFLOW__CORE__FERNET_KEY=8CioMWnUjLy1RdoXHw372eymi0Mt7w9I1hMkahV0wZw=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here_change_in_production

# Redis connection for Airflow (celery broker if needed)
AIRFLOW__CELERY__BROKER_URL=redis://:redis_secret_2026@redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://events:events_secret_2026@postgres:5432/today_events

# Backoffice
BACKOFFICE_PORT=8000
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backoffice
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin_secret_2026
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CELERY_BROKER_URL=redis://:redis_secret_2026@redis:6379/1
CACHE_REDIS_URL=redis://:redis_secret_2026@redis:6379/2

# OpenTelemetry
OTEL_ENABLED=true

# Frontend
FRONTEND_PORT=3000

# Traefik — dominio base per tutti i sottodomini
# Dev: 127.0.0.1.nip.io (HTTP, nip.io per localhost)
# Prod: dominio reale (es. events.example.com) — richiede DNS wildcard *.dominio -> IP server
DOMAIN=127.0.0.1.nip.io

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_2026

# SonarQube (code quality)
SONARQUBE_JDBC_PASSWORD=events_secret_2026

# Keycloak (Identity Provider)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret_2026

# API Authentication — Keycloak Client Credentials
# Genera client secret nella dashboard Keycloak: Realm > Clients > <client> > Credentials
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=today-events
KEYCLOAK_SCRAPER_CLIENT_ID=scraper-service
KEYCLOAK_SCRAPER_CLIENT_SECRET=CHANGE_ME_SCRAPER_SECRET
KEYCLOAK_AIRFLOW_CLIENT_ID=airflow-service
KEYCLOAK_AIRFLOW_CLIENT_SECRET=CHANGE_ME_AIRFLOW_SECRET

# oauth2-proxy (SSO gateway per tutti i servizi)
# Cookie secret: deve essere 16, 24 o 32 byte codificato base64
# Genera con: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=b2F1dGgyLXByb3h5LXNlY3JldC0zMg==
KEYCLOAK_BACKOFFICE_CLIENT_SECRET=CHANGE_ME_BACKOFFICE_SECRET

# Social Login — Google (Keycloak Identity Provider)
# Crea le credenziali su: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Social Login — GitHub (Keycloak Identity Provider)
# Crea una OAuth App su: https://github.com/settings/developers
# Homepage URL: https://auth.127.0.0.1.nip.io
# Callback URL: https://auth.127.0.0.1.nip.io/realms/today-events/broker/github/endpoint
GITHUB_CLIENT_ID=CHANGE_ME_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET

# Let's Encrypt (solo produzione — docker-compose.prod.yml)
# Email per registrazione certificato ACME — obbligatoria per HTTPS
ACME_EMAIL=admin@yourdomain.com
# Docker socket path — su macOS con Docker Desktop usa il path reale (non il symlink)
# Trova il path con: readlink -f /var/run/docker.sock
# Esempio macOS: DOCKER_SOCK=/Users/<username>/.docker/run/docker.sock
# Default (Linux / Docker standard): /var/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock