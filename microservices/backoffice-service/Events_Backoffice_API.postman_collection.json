		{
			"name": "Bulk Operations",
			"description": "Operazioni bulk: creazione massiva (async/sync), monitoraggio task, pulizia per sorgente.",
			"item": [
				{
					"name": "Bulk Create (Async - default)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 202) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('task_id', json.task_id);",
									"    pm.test('Task accettato', function () {",
									"        pm.expect(json.status).to.eql('PENDING');",
									"        pm.expect(json.task_id).to.be.a('string');",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"events\": [\n        {\n            \"uuid\": \"a1b2c3d4e5f6\",\n            \"content_hash\": \"f6e5d4c3b2a1\",\n            \"source\": \"city_today\",\n            \"url\": \"https://www.example.com/eventi/concerto-jazz-milano\",\n            \"title\": \"Concerto Jazz al Blue Note\",\n            \"description\": \"Una serata di musica jazz dal vivo con artisti internazionali.\",\n            \"category\": [\"musica\", \"jazz\", \"concerti\"],\n            \"image_url\": \"https://www.example.com/img/jazz-night.jpg\",\n            \"city\": \"milano\",\n            \"location_name\": \"Blue Note Milano\",\n            \"location_address\": \"Via Borsieri 37, 20159 Milano MI\",\n            \"price\": \"25,00 EUR\",\n            \"website\": \"https://www.bluenotemilano.com\",\n            \"date_start\": \"2026-02-15\",\n            \"date_end\": \"2026-02-15\",\n            \"time_start\": \"21:00:00\",\n            \"time_end\": \"23:30:00\",\n            \"time_info\": \"Apertura porte ore 19:30\",\n            \"schedule\": \"Venerdi e Sabato\",\n            \"weekdays\": \"fri,sat\",\n            \"raw_data\": {\"original_id\": \"12345\"},\n            \"scraped_at\": \"2026-02-05T14:30:00Z\"\n        },\n        {\n            \"uuid\": \"b2c3d4e5f6a1\",\n            \"content_hash\": \"a1f6e5d4c3b2\",\n            \"source\": \"city_today\",\n            \"url\": \"https://www.example.com/eventi/mostra-caravaggio-roma\",\n            \"title\": \"Mostra Caravaggio - Luci e Ombre\",\n            \"description\": \"Esposizione dedicata alle opere di Caravaggio con percorso multimediale.\",\n            \"category\": [\"arte\", \"mostre\", \"cultura\"],\n            \"image_url\": \"https://www.example.com/img/caravaggio.jpg\",\n            \"city\": \"roma\",\n            \"location_name\": \"Palazzo delle Esposizioni\",\n            \"location_address\": \"Via Nazionale 194, 00184 Roma RM\",\n            \"price\": \"15,00 EUR\",\n            \"website\": \"https://www.palazzoesposizioni.it\",\n            \"date_start\": \"2026-02-01\",\n            \"date_end\": \"2026-04-30\",\n            \"time_start\": \"10:00:00\",\n            \"time_end\": \"20:00:00\",\n            \"time_info\": \"Ultimo ingresso ore 19:00\",\n            \"schedule\": \"Da martedi a domenica\",\n            \"weekdays\": \"tue,wed,thu,fri,sat,sun\",\n            \"raw_data\": {\"original_id\": \"67890\"},\n            \"scraped_at\": \"2026-02-05T14:30:00Z\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/external/staging/bulk/",
							"host": ["{{base_url}}"],
							"path": ["api", "external", "staging", "bulk", ""]
						},
						"description": "Invia un batch di eventi per il processamento **asincrono** via Celery.\n\n**Response:** 202 Accepted con `task_id`\n\nIl `task_id` viene salvato automaticamente per controllare lo stato con **Bulk Status**."
					}
				},
				{
					"name": "Bulk Create (Sync)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"events\": [\n        {\n            \"uuid\": \"evt_001\",\n            \"source\": \"city_today\",\n            \"title\": \"Mercatino di Natale\",\n            \"city\": \"bologna\",\n            \"date_start\": \"2026-12-01\",\n            \"date_end\": \"2026-12-24\"\n        },\n        {\n            \"uuid\": \"evt_002\",\n            \"source\": \"city_today\",\n            \"title\": \"Sagra del Tartufo\",\n            \"city\": \"firenze\",\n            \"date_start\": \"2026-03-10\",\n            \"date_end\": \"2026-03-12\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/external/staging/bulk/?sync=true",
							"host": ["{{base_url}}"],
							"path": ["api", "external", "staging", "bulk", ""],
							"query": [
								{
									"key": "sync",
									"value": "true"
								}
							]
						},
						"description": "Crea eventi in modo **sincrono** (backward compatible).\n\n**Response:** 201 (tutti ok) / 200 (partial) / 400 (tutti falliti)\n\nRitorna `created_count`, `failed_count`, `successful_events`, `failed_events`."
					}
				},
				{
					"name": "Bulk Create (parzialmente validi)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"events\": [\n        {\n            \"uuid\": \"evt_003\",\n            \"source\": \"test_source\",\n            \"title\": \"Evento Valido di Prova\",\n            \"city\": \"milano\",\n            \"date_start\": \"2026-03-01\"\n        },\n        {\n            \"uuid\": \"evt_004\",\n            \"source\": \"test_source\",\n            \"city\": \"roma\",\n            \"date_start\": \"2026-03-02\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/external/staging/bulk/?sync=true",
							"host": ["{{base_url}}"],
							"path": ["api", "external", "staging", "bulk", ""],
							"query": [
								{
									"key": "sync",
									"value": "true"
								}
							]
						},
						"description": "Esempio con un evento valido e uno non valido (manca `title`).\n\n**Response atteso:** 200 (partial success) con `created_count: 1`, `failed_count: 1`."
					}
				},
				{
					"name": "Bulk Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/external/staging/bulk-status/{{task_id}}/",
							"host": ["{{base_url}}"],
							"path": ["api", "external", "staging", "bulk-status", "{{task_id}}", ""]
						},
						"description": "Controlla lo stato di un task di bulk create asincrono. Scope: `read`.\n\n**Stati possibili:** PENDING, STARTED, SUCCESS, FAILURE\n\nQuando SUCCESS, il campo `result` contiene `created_count`, `failed_count`, `failed_events`."
					}
				},
				{
					"name": "Clear Source",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/external/staging/clear_source/?source=city_today",
							"host": ["{{base_url}}"],
							"path": ["api", "external", "staging", "clear_source", ""],
							"query": [
								{
									"key": "source",
									"value": "city_today"
								}
							]
						},
						"description": "Elimina tutti gli staging events di una specifica sorgente. Scope: `write`.\n\nUtile per pulire i dati prima di un nuovo import."
					}
				}
			]
		},
