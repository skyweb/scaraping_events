{
	"info": {
		"name": "Events Backoffice API",
		"description": "Collection completa per le API del backoffice eventi.\n\n## Setup\n1. Esegui prima **OAuth2 - Get Token** per ottenere il token\n2. Il token viene salvato automaticamente nella variabile `access_token`\n3. Tutte le altre richieste usano `{{access_token}}` nell'header Authorization\n\n## Flusso Bulk Async\n1. POST Bulk Create (async) → ricevi `task_id`\n2. GET Bulk Status con il `task_id` → verifica stato\n\n## Flusso Bulk Sync\n1. POST Bulk Create Sync (`?sync=true`) → ricevi risultato immediato",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "client_id",
			"value": "pkckUgXSYZX4kP55yaWb9IBPv5Zh4CNp7iJy2dJM",
			"type": "string"
		},
		{
			"key": "client_secret",
			"value": "oxCFhhl3QjufXYH3f7T9zG27QSPWpZS5mciU69CHUII",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "event_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "task_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"description": "Autenticazione OAuth2 client_credentials",
			"item": [
				{
					"name": "OAuth2 - Get Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('access_token', json.access_token);",
									"    pm.test('Token ottenuto con successo', function () {",
									"        pm.expect(json.access_token).to.be.a('string');",
									"        pm.expect(json.token_type).to.eql('Bearer');",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials"
								},
								{
									"key": "client_id",
									"value": "{{client_id}}"
								},
								{
									"key": "client_secret",
									"value": "{{client_secret}}"
								},
								{
									"key": "scope",
									"value": "read write"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/oauth/token/",
							"host": ["{{base_url}}"],
							"path": ["oauth", "token", ""]
						},
						"description": "Ottiene un access token OAuth2 con grant_type=client_credentials.\n\nIl token viene salvato automaticamente nella variabile `access_token`."
					}
				}
			]
		},
		{
			"name": "Staging Events (External API)",
