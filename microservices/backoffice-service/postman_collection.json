      ]
    },
    {
      "name": "Internal API",
      "item": [
        {
          "name": "Dashboard stats",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/dashboard/",
