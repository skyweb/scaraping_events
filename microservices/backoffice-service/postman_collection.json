          }
        },
        {
          "name": "Production events",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/events/?page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "events", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "city", "value": "", "disabled": true },
