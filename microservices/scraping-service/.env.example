# =============================================================================
# Service Scraping - Docker Compose Environment
# =============================================================================
# Copia questo file in .env per usarlo con docker-compose
# cp .env.example .env

# =============================================================================
# DATABASE POSTGRESQL
# =============================================================================
# Host del database (usa "postgres" se nella stessa rete Docker)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=today_events
POSTGRES_USER=events
POSTGRES_PASSWORD=your_secure_password_here

# =============================================================================
# SCRAPY SETTINGS
# =============================================================================
# Livello di log: DEBUG, INFO, WARNING, ERROR, CRITICAL
SCRAPY_LOG_LEVEL=INFO

# Numero massimo richieste concorrenti
SCRAPY_CONCURRENT_REQUESTS=8

# Richieste concorrenti per dominio
SCRAPY_CONCURRENT_REQUESTS_PER_DOMAIN=2

# Delay tra richieste (secondi)
SCRAPY_DOWNLOAD_DELAY=1.0

# =============================================================================
# SCRAPYD
# =============================================================================
# Porta esposta per Scrapyd (default: 6800)
SCRAPYD_PORT=6800

# =============================================================================
# KEYCLOAK (OAuth2 Client Credentials per scraper-service)
# =============================================================================
# Token endpoint Keycloak
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/today-events/protocol/openid-connect/token

# Credenziali OAuth2 — client "scraper-service" in Keycloak
# Grant type: Client credentials
# Scopes: openid read write
API_CLIENT_ID=scraper-service
API_CLIENT_SECRET=your_client_secret_here

# =============================================================================
# API INGESTION (per ApiPipeline)
# =============================================================================
# URL base del backoffice (in Docker: http://backoffice:8000)
API_BASE_URL=http://backoffice:8000

# Numero eventi per batch (default: 50)
API_BATCH_SIZE=50

# Timeout richieste API in secondi (default: 30)
API_TIMEOUT=30

# =============================================================================
# OPENTELEMETRY (tracing distribuito)
# =============================================================================
# Abilita/disabilita OpenTelemetry
OTEL_ENABLED=false

# Nome servizio per i trace
OTEL_SERVICE_NAME=scraping-service

# Endpoint OTLP collector (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# =============================================================================
# MINIO (storage oggetti per output files)
# =============================================================================
# Usato solo con -s STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=scraping-output
